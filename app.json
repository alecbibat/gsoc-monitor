{
  "name": "GSOC Monitor",
  "description": "Real-time 3D globe situational awareness dashboard",
  "keywords": ["node", "express", "react", "cesium", "globe", "dashboard"],
  "env": {
    "NWS_USER_AGENT": {
      "description": "Contact string (app name + email) sent to api.weather.gov per NWS API policy, e.g. \"gsoc-monitor (you@email.com)\"",
      "required": false
    }
  },
  "formation": {
    "web": {
      "quantity": 1,
      "size": "basic"
    }
  },
  "buildpacks": [
    {
      "url": "heroku/nodejs"
    }
  ]
}
