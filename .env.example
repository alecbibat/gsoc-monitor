# Server port (Heroku sets this automatically; default for local dev)
PORT=5174

# Contact info sent as the User-Agent to api.weather.gov, per NWS API policy.
# Format recommended by NWS: "AppName (contact@email.com)"
NWS_USER_AGENT=gsoc-monitor (you@example.com)
# Flights come from adsb.fi's free open ADS-B API — no key or account needed.

# --- Ship positions -----------------------------------------------------------
# Every source configured below is polled on each cycle and the best answer per
# ship wins (a stated fix time beats a guessed one, then the newer fix).
#
# Coverage is the thing that matters: AISSTREAM and the CruiseMapper scrape are
# effectively coastal, so a vessel in open ocean sits at her last inshore
# position until she is heard again. MarineTraffic carries satellite AND roaming
# AIS (positions relayed by partner fleets), which is what sees a ship
# mid-ocean. Set a key here if the fleet crosses oceans.
# MARINETRAFFIC_API_KEY=
# How far back to ask MarineTraffic for a position, in minutes (default 1440).
# MARINETRAFFIC_TIMESPAN_MIN=1440
# VESSELFINDER_API_KEY=
# MYSHIPTRACKING_API_KEY=
# Minutes between position polls (default 120, minimum 15).
# SHIPS_POLL_MINUTES=120
