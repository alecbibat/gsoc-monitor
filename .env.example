# Server port (Heroku sets this automatically; default for local dev)
PORT=5174

# Contact info sent as the User-Agent to api.weather.gov, per NWS API policy.
# Format recommended by NWS: "AppName (contact@email.com)"
NWS_USER_AGENT=gsoc-monitor (you@example.com)

# Optional: OpenSky Network OAuth2 client credentials for higher flight-data
# rate limits. Leave blank to use anonymous access (works, but rate-limited).
# Create an account + API client at https://opensky-network.org/
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
