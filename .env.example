# Server port (Heroku sets this automatically; default for local dev)
PORT=5174

# Contact info sent as the User-Agent to api.weather.gov, per NWS API policy.
# Format recommended by NWS: "AppName (contact@email.com)"
NWS_USER_AGENT=gsoc-monitor (you@example.com)
# Flights come from adsb.fi's free open ADS-B API — no key or account needed.

# IQAir AirVisual API key for the World Air Quality layer — free "Community"
# key from https://dashboard.iqair.com (10,000 calls/month; the server's city
# sweep is budgeted to ~7,700/month). Leave unset to disable the layer.
# Per-point air-quality forecasts use Open-Meteo/CAMS and need no key.
IQAIR_API_KEY=
