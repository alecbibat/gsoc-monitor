# Server port (Heroku sets this automatically; default for local dev)
PORT=5174

# Contact info sent as the User-Agent to api.weather.gov, per NWS API policy.
# Format recommended by NWS: "AppName (contact@email.com)"
NWS_USER_AGENT=gsoc-monitor (you@example.com)
# Flights come from adsb.fi's free open ADS-B API — no key or account needed.

# ── Authentication ────────────────────────────────────────────────────────────
# Required. Signs the session cookie; changing it signs everyone out.
JWT_SECRET=change-me-to-a-long-random-string

# How email+password sign-in behaves alongside SSO. Roll through these in order:
#   all        — everyone can use a password or SSO (default; use during migration)
#   admin-only — only admins keep a password; everyone else must use SSO
#   off        — passwords disabled entirely (not recommended: an IdP outage is
#                exactly the incident this app exists to coordinate)
PASSWORD_LOGIN_MODE=all

# Self-serve signup with the shared code. Set false once accounts are created
# from the admin panel and SSO carries everyone in.
SIGNUP_ENABLED=true

# ── Single sign-on (OIDC) ─────────────────────────────────────────────────────
# SSO switches itself on only when ISSUER + CLIENT_ID + CLIENT_SECRET are all
# set, so a half-configured deployment never shows a dead sign-in button.
# Ask IT for OIDC rather than SAML: the callback is a plain redirect, which
# avoids the cross-site-POST cookie problems SAML's ACS endpoint runs into.
#OIDC_ISSUER=https://your-org.okta.com/oauth2/default
#OIDC_CLIENT_ID=
#OIDC_CLIENT_SECRET=
# Must match the redirect URI registered with the IdP, exactly.
#OIDC_REDIRECT_URI=https://your-app.example.com/api/auth/sso/callback
#OIDC_SCOPE=openid email profile
#SSO_BUTTON_LABEL=Sign in with Company SSO

# Email domains the IdP is authoritative for. Leave unset only for a
# single-tenant app registration — with a multi-tenant one, any account at the
# provider can otherwise complete the flow.
#SSO_ALLOWED_DOMAINS=company.com,contractors.company.com

# false (default) = an admin pre-creates accounts and the first SSO login links
# them by email. true = create an account on first SSO login.
#SSO_AUTO_PROVISION=false
#SSO_DEFAULT_ROLE=member
